# Frontend Production & Development Environment Variables

# Base REST API URL of deployed health_backend Spring Boot server
# Local dev default: http://localhost:8080/api
# Production sample: https://health-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# Default IoT Device Identifier
VITE_DEFAULT_DEVICE_ID=ESP32-DEMO-001
