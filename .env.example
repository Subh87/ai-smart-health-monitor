# AI Smart Health Monitor - Root Environment Configuration Example

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL with SQLite fallback)
DATABASE_URL=postgres://health_user:health_password@localhost:5432/health_db
USE_SQLITE_FALLBACK=true

# Security
JWT_SECRET=super_secret_jwt_key_change_in_production_12345
CORS_ORIGIN=http://localhost:5173

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here

# ESP32 Default Device Config
DEFAULT_DEVICE_ID=ESP32-HEALTH-001
