# health_backend Environment Variables

# HTTP Server Port (Render/Railway/Heroku injects PORT automatically)
PORT=8080

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (Comma-separated list of live frontend domains)
APP_CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# JWT Secret Key (Must be a 256-bit / 64-character hexadecimal string)
APP_JWT_SECRET=9a6e8b7c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a
